{
  "typescript": {
    "quoteStyle": "preferSingle",
    "semiColons": "always",
    "lineWidth": 100,
    "indentWidth": 2
  },
  "json": {
    "indentWidth": 2,
    "lineWidth": 100
  },
  "markdown": {
    "lineWidth": 100
  },
  "includes": [
    "**/*.{ts,tsx,js,jsx,json,md}"
  ],
  "excludes": [
    "**/node_modules",
    "**/dist",
    "src-tauri/**",
    "pnpm-lock.yaml",
    ".superpowers/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.93.4.wasm",
    "https://plugins.dprint.dev/json-0.19.4.wasm",
    "https://plugins.dprint.dev/markdown-0.17.8.wasm"
  ]
}
