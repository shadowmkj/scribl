{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scribl",
  "version": "0.1.0",
  "identifier": "com.milan.scribl",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "scribl",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Graphics",
    "shortDescription": "Minimal, modal, keyboard-centric canvas for infinite thinking",
    "longDescription": "Scribl is a high-performance vector canvas for thinking and sketching, featuring 240Hz stroke rendering, geometric shapes, text editing, custom themes, Lua-driven configuration, and multi-format drawing import.",
    "copyright": "Copyright © 2026 Milan Pramod",
    "publisher": "Milan Pramod",
    "licenseFile": "../LICENSE",
    "fileAssociations": [
      {
        "ext": ["scribl"],
        "name": "Scribl Canvas Drawing",
        "description": "Scribl infinite canvas drawing document",
        "mimeType": "application/x-scribl",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
